# ─── SPA Routing ─────────────────────────────────────────────────────────────
# Serve index.html for all routes so React Router handles navigation
Options -MultiViews
RewriteEngine On

# If the request is for an existing file or directory, serve it directly
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Otherwise rewrite to index.html (React handles the route)
RewriteRule ^ /index.html [L]

# ─── Cache Control ───────────────────────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On

  # HTML — never cache so users always get the latest app
  ExpiresByType text/html                 "access plus 0 seconds"

  # JS/CSS — cache 1 year (Vite adds content hashes to filenames)
  ExpiresByType application/javascript    "access plus 1 year"
  ExpiresByType text/css                  "access plus 1 year"

  # Images — cache 1 year
  ExpiresByType image/jpeg                "access plus 1 year"
  ExpiresByType image/png                 "access plus 1 year"
  ExpiresByType image/webp                "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 1 year"
  ExpiresByType image/x-icon              "access plus 1 year"
  ExpiresByType image/vnd.microsoft.icon  "access plus 1 year"

  # Video — cache 1 year
  ExpiresByType video/mp4                 "access plus 1 year"

  # Fonts — cache 1 year
  ExpiresByType font/woff2                "access plus 1 year"
  ExpiresByType font/woff                 "access plus 1 year"
  ExpiresByType application/font-woff2    "access plus 1 year"

  # JSON/XML — short cache
  ExpiresByType application/json          "access plus 1 day"
  ExpiresByType application/xml           "access plus 1 day"
  ExpiresByType text/xml                  "access plus 1 day"
</IfModule>

# ─── GZIP Compression ────────────────────────────────────────────────────────
# Compress text assets before sending — reduces transfer size by 60-80%
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE font/woff2
  AddOutputFilterByType DEFLATE font/woff
</IfModule>

# ─── Security Headers ────────────────────────────────────────────────────────
<IfModule mod_headers.c>
  # Prevent clickjacking
  Header always set X-Frame-Options "DENY"

  # Prevent MIME type sniffing
  Header always set X-Content-Type-Options "nosniff"

  # Control referrer info sent to other sites
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Restrict browser features
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  # Force HTTPS — tell browsers to only use HTTPS for 1 year
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # Cache-Control for HTML specifically
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>

# ─── HTTPS Redirect ──────────────────────────────────────────────────────────
# Force all HTTP traffic to HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ─── WWW Redirect ────────────────────────────────────────────────────────────
# Redirect www to non-www (canonical domain)
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# ─── Block Access to Sensitive Files ─────────────────────────────────────────
<FilesMatch "(^\.env|\.bak$|\.map$|\.log$)">
  Order allow,deny
  Deny from all
</FilesMatch>
